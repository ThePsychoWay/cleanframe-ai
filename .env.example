# CleanFrame AI — environment template. Copy to .env and fill in real values.
# Never commit .env or real secrets.

# --- Local mode: run on your own computer with nothing to install or sign up for ---
# Easiest: `python run_local.py` (it sets all of this for you). Setting LOCAL_MODE=true yourself replaces PostgreSQL, Redis and
# S3 with a SQLite file, the disk and threads, and picks AI_PROVIDER=auto unless you set it. Everything below is optional.
# LOCAL_MODE=true
# LOCAL_DATA_DIR=cleanframe-data        # database, videos and the generated secret live here
# API_PUBLIC_URL=http://localhost:8000  # must be localhost; signed file links point here
# LOCAL_WORKERS=1                       # videos processed at once (1 = least memory)
# OVERLAY_MEMORY_MB=1024                # memory the overlay measurement may use (minimum 256)

# --- Core services ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://cleanframe:<POSTGRES_PASSWORD>@postgres:5432/cleanframe
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible; MinIO for local development) ---
STORAGE_ENDPOINT=http://minio:9000
# Browsers upload parts straight to storage, so they need an address they can reach. Set this when it
# differs from STORAGE_ENDPOINT (inside Docker the API sees minio:9000, the browser sees localhost:9000).
# Leave empty to use STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=cleanframe
STORAGE_REGION=us-east-1
# Size of each upload part in bytes. S3 requires at least 5 MiB (5242880); default is 8 MiB.
UPLOAD_PART_SIZE=8388608

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Session lifetime in minutes (default 12 hours).
JWT_EXPIRE_MINUTES=720
# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# --- AI / inpainting ---
# auto  - the exact method when the mark allows it, otherwise reconstruction: a fixed semi-transparent logo is measured
#         from the video and taken off exactly (real pixels, works on a still camera); anything else is rebuilt from
#         other frames (below). The render's notes say which was used and why.
# overlay - only the exact method above; stops with a reason if the mark isn't a fixed semi-transparent logo.
# reconstruct - rebuilds the marked area from the other frames of your own video: real pixels, no blur, no model.
#               Works when the camera or the mark moves. Areas hidden in every frame (a fixed mark on a still camera)
#               go to LaMa when a model is configured (RECONSTRUCT_FALLBACK), otherwise the render stops and says so.
# lama  - LaMa (Apache-2.0, ONNX): generates a plausible fill for each frame. Needs AI_MODEL_PATH (and onnxruntime).
# local - a PyTorch model that handles one image at a time        (needs AI_MODEL_PATH and requirements-ai.txt)
# video - a PyTorch model that handles a clip of frames at a time (needs AI_MODEL_PATH and requirements-ai.txt)
# api   - a remote service (needs AI_API_URL and AI_API_KEY). Picture data around the marked areas is sent to it.
# dev   - OpenCV inpainting that BLURS the area, labelled "development only, not AI". Refused when DEV_MODE=false.
# There is no silent fallback: if the chosen engine isn't set up, processing stops with a clear message.
AI_PROVIDER=auto
# reconstruct: what to do with areas no other frame shows. auto = LaMa if AI_MODEL_PATH is set, else stop; lama; none.
RECONSTRUCT_FALLBACK=auto
# lama: an ONNX LaMa model file. local/video: a torch.export program (.pt2) or a TorchScript file. Only use files you trust.
AI_MODEL_PATH=
# Optional download when AI_MODEL_PATH doesn't exist yet: HTTPS only; the SHA-256 of the file is required and checked.
AI_MODEL_URL=
AI_MODEL_SHA256=
# video: frames per model call, and frames shared between calls (clip_frames >= 2 * overlap + 1).
AI_VIDEO_CLIP_FRAMES=16
AI_VIDEO_OVERLAP_FRAMES=4
# api: HTTPS address of the service, its key, and how long to wait for one answer.
AI_API_URL=
AI_API_KEY=
AI_API_TIMEOUT_SECONDS=60
# auto = use an NVIDIA GPU if PyTorch can; true = want a GPU (still falls back to the CPU); false = CPU only.
CUDA_ENABLED=auto
# Keep the generative model loaded between videos and load it when the app starts (faster first video; costs ~0.2 GB while idle).
AI_KEEP_MODEL_LOADED=true

# Local mode only: set by `run_local.py --lan` (phone access); leave unset otherwise. See docs/LOCAL.md.
# LOCAL_LAN=true

# --- Limits and retention ---
# Largest upload in bytes (default 2 GiB: a 4K clip is several hundred MB per minute). Uploads go in 8 MiB parts and an
# interrupted one resumes. Set NEXT_PUBLIC_MAX_UPLOAD_SIZE to the same number so the page can refuse early.
MAX_UPLOAD_SIZE=2147483648
MAX_VIDEO_DURATION_SECONDS=120
# Free disk the server must keep after taking a video (MB). An upload or a render that would not fit is refused up front with a
# clear message instead of failing half way. Working copies need roughly 1.5x (analysis) to 3.5x (render) the upload's size.
MIN_FREE_DISK_MB=512
# Uploads, previews and results are deleted this long after the upload finishes (and again after each finished
# render, so a result stays downloadable for the full period). Access stops at the deadline; the files are removed
# when somebody opens the project or when the sweep runs.
VIDEO_RETENTION_HOURS=48
CLEANUP_INTERVAL_SECONDS=900          # how often the sweep runs (needs `celery -A app.workers.celery_app beat`)
# Largest frame accepted, as width x height in pixels (default 4096 x 2304 = 9,437,184, which fits 4K UHD and DCI 4K).
MAX_VIDEO_PIXELS=9437184
# Encoder for the finished video and for exports. auto = NVIDIA NVENC when a real test encode on this machine succeeds, else
# the CPU encoders (x264, x265, libvpx-vp9); cpu = never use the GPU; nvenc = same as auto but say so in the log if it can't.
VIDEO_ENCODER=auto
# Memory the temporal engine may use for the frames it keeps around the one being rebuilt (MB). A 4K frame is ~25 MB, so the
# window of neighbouring frames shrinks on big pictures to stay inside this budget (and the job's notes say so).
TEMPORAL_MEMORY_MB=1536

# --- Background jobs ---
# true runs tasks inline in the API process. For tests and single-process development only;
# normally a Celery worker consumes the queue:  celery -A app.workers.celery_app worker -Q cpu
CELERY_EAGER=false

# --- Security and logging (Phase 11) ---
# Rate limits count in Redis (shared by every API process). `memory` is for development only, and production refuses it,
# and refuses RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=auto               # auto = redis unless DEV_MODE | memory | redis
# How many reverse proxies sit in front of the API and add to X-Forwarded-For. 0 = none: the header is ignored,
# so it can't be used to dodge a limit. Behind one load balancer set 1.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
LOG_FORMAT=auto                       # auto = JSON lines in production, readable text when DEV_MODE=true

# --- Development ---
# When true, expensive AI processing is replaced by the clearly labeled dev engine.
DEV_MODE=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public address of the S3-compatible store (where browsers upload to and play from). Used for the page's
# Content-Security-Policy; leave empty in development.
NEXT_PUBLIC_STORAGE_ORIGIN=

# Largest request body any API route accepts (uploads go straight to storage, so this is small)
MAX_REQUEST_BODY_BYTES=2097152

# Mask tracking: longest a tracking job may run before it is stopped (seconds)
TRACKING_TIME_LIMIT_SECONDS=1500

# Rendering jobs (Phase 9)
RENDER_TIME_LIMIT_SECONDS=7200        # soft limit; the hard limit is 5 minutes later
RENDER_QUEUE=auto                     # auto | cpu | gpu. auto: local/video engines -> gpu, dev/api -> cpu
MAX_ACTIVE_JOBS_PER_USER=2
JOB_HEARTBEAT_SECONDS=15
JOB_LOST_AFTER_SECONDS=120            # a running job with no heartbeat this long is reported failed
JOB_QUEUE_TIMEOUT_SECONDS=7200        # a job nobody picked up this long is reported failed
WORKER_TMP_DIR=                       # where workers keep large temporary files; empty = system temp

# Docker: the compose file starts the API and a CPU worker (`cpu` queue). With `--profile gpu` it also starts a GPU
# worker (`gpu` queue) that needs AI_PROVIDER=local or video, AI_MODEL_PATH=/models/<file> and the model file in ./models.
# On one machine without a GPU, set RENDER_QUEUE=cpu so every render goes to the CPU worker.

# --- Upload malware scanning (optional) ---
# off: no scan. clamav: every upload is streamed to a clamd server before it is analysed (docker compose --profile scan
# starts one as `clamav`). If scanning is on and the scanner can't answer, uploads are NOT processed (fails closed).
# clamd's StreamMaxLength and MaxFileSize must be at least MAX_UPLOAD_SIZE or large files are refused or skipped.
MALWARE_SCAN=off
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=300

# --- Storage lifecycle (applied with: python -m app.storage.provision) ---
# The bucket removes anything under uploads/, derived/ and outputs/ this many days after retention should have
# ended, and discards unfinished multipart uploads after STORAGE_ABORT_UPLOADS_DAYS. A backstop, not the main cleanup.
STORAGE_LIFECYCLE_MARGIN_DAYS=2
STORAGE_ABORT_UPLOADS_DAYS=2

# --- Hosted setup (website on Vercel, backend on one server). See docs/DEPLOY.md ---
# API_DOMAIN=api.example.com        # public https address of the API (DNS A record -> your server)
# STORAGE_DOMAIN=files.example.com  # public https address browsers upload to (DNS A record -> your server)
# For this setup also set: DEV_MODE=false, STORAGE_PUBLIC_ENDPOINT=https://files.example.com,
# CORS_ORIGINS=https://<your-site>.vercel.app, NEXT_PUBLIC_STORAGE_ORIGIN=https://files.example.com
